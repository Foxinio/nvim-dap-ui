#!/bin/sh
# Usage: scripts/test [spec-file]. Dependencies come from DEPS_DIR or lazy.nvim's
# plugin directory (see tests/init.lua).
nvim=${NVIM:-nvim}
init=tests/init.lua

target=${1:-tests/}
output=$("$nvim" --headless --noplugin -u "$init" \
	-c "PlenaryBustedDirectory $target {minimal_init = '$init', sequential = true}" 2>&1)
status=$?
printf '%s\n' "$output"

# Plenary doesn't emit exit code 1 when tests have errors during setup
if [ "$status" -ne 0 ] || printf '%s\n' "$output" | sed 's/\x1b\[[0-9;]*m//g' |
	grep -Eq '(Failed|Errors) :[[:space:]]*[1-9]'; then
	echo "Tests failed"
	exit 1
fi
